# Copia este ficheiro para ".env" e ajusta os valores se necessário.
# O .env real nunca deve ser commitado (já está no .gitignore).

# Ligação à base de dados PostgreSQL — os valores por omissão correspondem ao serviço "postgres" definido no docker-compose.yaml da raiz do projeto.
DATABASE_URL="postgresql://horarios:horarios@localhost:5432/horarios"

# Chave secreta usada para assinar e validar os tokens JWT.
# Usa uma string longa e aleatória (diferente em cada ambiente).
JWT_SECRET="muda-me-para-uma-string-secreta-e-aleatoria"

# Password do utilizador ADMIN criado por "npx prisma db seed" (backend/src/seed.ts).
# Define a tua própria; se não definires, usa-se "Admin123!" apenas para desenvolvimento local.
SEED_ADMIN_PASSWORD="define-uma-password-forte-aqui"
